{
  "name": "voting-guide",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "node scripts/build-data.mjs && vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-data.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "node tests/e2e.mjs",
    "test:model": "node scripts/build-data.mjs && node tests/model.mjs",
    "check": "node scripts/check-addresses.mjs && node scripts/build-data.mjs && node scripts/check-data.mjs",
    "sweep": "node tests/sweep.mjs",
    "shots": "node tests/shots.mjs",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "11.8.0",
    "playwright": "^1.64.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@sentry/browser": "11.8.0"
  }
}
